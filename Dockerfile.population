FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY apps/api/requirements-population-job.lock ./requirements-population-job.lock
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-population-job.lock

COPY packages /packages
COPY data_catalog /data_catalog
COPY scripts/validate_population_backends.py ./validate_population_backends.py

ENV PYTHONPATH="/app:/packages" \
    DATA_CATALOG_ROOT="/data_catalog" \
    HOME="/home/appuser"

RUN useradd --create-home --uid 10001 appuser
USER appuser

CMD ["python", "/app/validate_population_backends.py", "--output", "/tmp/population-validation.json"]
